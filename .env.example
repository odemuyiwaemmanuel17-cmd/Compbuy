# ---------------------------------------------------------------------------
# Compbuy environment
# Copy to .env and fill in the values from your Supabase project dashboard:
#   Project settings -> API
# ---------------------------------------------------------------------------

# Application
APP_ENV=development
APP_DEBUG=true
SITE_NAME=Compbuy
LOG_LEVEL=info

# Supabase (Project settings -> API)
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-anon-key
# Server-side only. Grants the SSR layer access beyond RLS; authorisation is
# enforced in the service layer. Never expose this to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# Sessions (signs the httpOnly cookie that carries Supabase tokens)
# Generate: python -c "import secrets; print(secrets.token_urlsafe(32))"
SESSION_SECRET=
SESSION_COOKIE_NAME=compbuy_session
SESSION_MAX_AGE_SECONDS=604800
# Set true when serving over HTTPS
COOKIE_SECURE=false

# Catalogue
LISTINGS_PER_PAGE=12
