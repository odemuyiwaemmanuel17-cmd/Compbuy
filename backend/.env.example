# Environment Configuration for Compbuy

NODE_ENV=development
PORT=5000
FRONTEND_URL=http://localhost:3000

DB_HOST=<supabase-host.supabase.co>
DB_PORT=5432
DB_NAME=postgres
DB_USER=postgres
DB_PASSWORD=<pw>
DB_SSL=true
DB_POOL_MAX=20

JWT_SECRET=<64B hex>
JWT_REFRESH_SECRET=<64B hex>
JWT_STEPUP_SECRET=<64B hex>
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d
JWT_STEPUP_EXPIRES_IN=5m
JWT_ISSUER=compbuy.ng
JWT_AUDIENCE=compbuy-app

BCRYPT_SALT_ROUNDS=13
MAX_LOGIN_ATTEMPTS=5
LOCKOUT_DURATION_MINUTES=30
PASSWORD_HISTORY_COUNT=5
SUSPICIOUS_LOGIN_RISK_THRESHOLD=60

TOTP_ISSUER=Compbuy
MFA_REQUIRED_FOR_SELLERS=true
MFA_REQUIRED_FOR_HIGH_VALUE=true
HIGH_VALUE_THRESHOLD_NGN=100000000

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=<gmail>
SMTP_PASS=<app-password>
EMAIL_FROM=Compbuy Security <security@compbuy.ng>

SMS_PROVIDER=termii
TERMII_API_KEY=<key>
TERMII_SENDER_ID=Compbuy

CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:5500

RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
AUTH_RATE_LIMIT_MAX=8
OTP_RATE_LIMIT_MAX=4
UPLOAD_RATE_LIMIT_MAX=20

UPLOAD_DIR=uploads
MAX_FILE_SIZE_MB=15

COOKIE_SECURE=false
COOKIE_SAME_SITE=strict
COOKIE_DOMAIN=

FIELD_ENCRYPTION_KEY=<32B hex>

MAX_LISTINGS_PER_UNVERIFIED_SELLER=1
MAX_LISTINGS_PER_VERIFIED_SELLER=15
LISTING_EXPIRY_DAYS=90

ADMIN_EMAIL=admin@compbuy.ng
ADMIN_TEMP_PASSWORD=Admin@Compbuy2025!

LOG_LEVEL=info
LOG_DIR=logs
